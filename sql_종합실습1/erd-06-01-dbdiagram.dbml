TableGroup academic_core [color: #DBEAFE, note: '학사관리 영역'] {
  academic.department
  academic.student
  academic.professor
  academic.subject
  academic.course_offering
  academic.enrollment
}

TableGroup audit_identity [color: #EDE9FE, note: '감사 행위자와 역할'] {
  audit.audit_actor
  audit.audit_actor_role
}

TableGroup audit_change [color: #EDE9FE, note: '변경 요청·승인·처리·기록'] {
  audit.change_request
  audit.change_approval
  audit.change_operation
